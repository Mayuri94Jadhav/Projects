    >
      <div className="flex items-center gap-2">
        <div className="w-8 h-8 rounded-md flex items-center justify-center font-bold" style={{ background: T.amber, color: "#181818" }}>
          ✓
        </div>
        <span style={{ color: T.text, fontWeight: 700 }}>Sheet<span style={{ color: T.amber }}>50</span></span>
      </div>

      {view !== "session" ? (
        <div className="flex items-center gap-1">
          {items.map((it) => {
            const Icon = it.icon;
            const active = view === it.id;
            return (
              <button
