const uid = () => "q_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);

async function loadKey(key, fallback) {
  try {
    const v = localStorage.getItem(key);
    return v ? JSON.parse(v) : fallback;
  } catch {
    return fallback;
  }
}

async function saveKey(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
    return true;
  } catch {
    return false;
  }
}

function buildSession(bank, size = 50) {
  const pool = bank.map((q) => {
    const seen = q.timesSeen || 0;
    const wrong = q.timesWrong || 0;
    const weight = seen === 0 ? 6 : 1 + (wrong / Math.max(seen, 1)) * 5;
    return { q, weight };
  });

  const n = Math.min(size, pool.length);
  const working = [...pool];
  const chosen = [];

  for (let i = 0; i < n; i++) {
    const total = working.reduce((s, x) => s + x.weight, 0);
    let r = Math.random() * total;
    let idx = 0;
    for (; idx < working.length; idx++) {
      r -= working[idx].weight;
      if (r <= 0) break;
    }
    idx = Math.min(idx, working.length - 1);
    chosen.push(working[idx].q);
    working.splice(idx, 1);
  }

  for (let i = chosen.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [chosen[i], chosen[j]] = [chosen[j], chosen[i]];
  }
  return chosen;
}

function weakCategories(bank) {
  const map = {};
  bank.forEach((q) => {
    const cat = (q.category || "Uncategorized").trim() || "Uncategorized";
    if (!map[cat]) map[cat] = { seen: 0, wrong: 0 };
    map[cat].seen += q.timesSeen || 0;
    map[cat].wrong += q.timesWrong || 0;
  });
  return Object.entries(map)
    .filter(([, v]) => v.seen > 0)
    .map(([cat, v]) => ({ cat, rate: v.wrong / v.seen, seen: v.seen }))
    .sort((a, b) => b.rate - a.rate)
    .slice(0, 5);
}

function normalizeKey(k) {
  return String(k).trim().toLowerCase().replace(/[^a-z0-9]/g, "");
}

function parseAnswer(answerRaw, options = []) {
  const ans = String(answerRaw || "").trim();
  if (!ans) return -1;
  if (/^[a-d]$/i.test(ans)) return ans.toUpperCase().charCodeAt(0) - 65;
  if (/^[1-4]$/.test(ans)) return parseInt(ans, 10) - 1;
  return options.findIndex((o) => String(o).trim().toLowerCase() === ans.toLowerCase());
}

function parseRowToQuestion(row) {
  const norm = {};
  Object.keys(row).forEach((k) => {
    norm[normalizeKey(k)] = row[k];
  });

  const question = String(norm.question || norm.q || norm.questiontext || norm.prompt || "").trim();

  const optionSets = [
    ["optiona", "a", "choicea", "opt1"],
    ["optionb", "b", "choiceb", "opt2"],
    ["optionc", "c", "choicec", "opt3"],
    ["optiond", "d", "choiced", "opt4"],
  ];

  const options = optionSets.map((keys) => {
    for (const k of keys) {
      if (norm[k] !== undefined && String(norm[k]).trim() !== "") return String(norm[k]).trim();
    }
    return "";
  });

  const correctIndex = parseAnswer(norm.answer || norm.correct || norm.correctanswer || norm.correctoption || norm.ans, options);
  const category = String(norm.category || norm.topic || norm.tag || "").trim();

  return { question, options, correctIndex, category };
}

function parseFileToRows(arrayBuffer) {
  const wb = XLSX.read(arrayBuffer, { type: "array" });
  const sheet = wb.Sheets[wb.SheetNames[0]];
  return XLSX.utils.sheet_to_json(sheet, { defval: "" });
}

function Btn({ children, onClick, variant = "default", disabled, className = "", type = "button" }) {
  const base = {
    default: { background: T.amber, color: "#181818", border: `1px solid ${T.amber}` },
    ghost: { background: "transparent", color: T.text, border: `1px solid ${T.border}` },
    subtle: { background: T.panelAlt, color: T.text, border: `1px solid ${T.border}` },
    danger: { background: "transparent", color: T.red, border: `1px solid ${T.red}55` },
  }[variant];

  return (
    <button
      type={type}
      onClick={onClick}
      disabled={disabled}
      className={`px-4 py-2 rounded-lg text-sm font-medium inline-flex items-center gap-2 ${className}`}
      style={{
        ...base,
        opacity: disabled ? 0.4 : 1,
        cursor: disabled ? "not-allowed" : "pointer",
      }}
    >
      {children}
    </button>
  );
}

function Card({ children, className = "", style = {} }) {
  return (
    <div
      className={`rounded-xl p-5 ${className}`}
      style={{ background: T.panel, border: `1px solid ${T.border}`, ...style }}
    >
      {children}
    </div>
  );
}

